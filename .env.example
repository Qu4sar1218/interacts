# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3030/api

# Face-api.js model weights (default: /models → public/models)
# VITE_FACE_MODEL_URL=/models

# Access/refresh cookie lifetimes are derived automatically from the JWT exp claim
# issued by the backend (ACCESS_TOKEN_EXPIRY / REFRESH_TOKEN_EXPIRY in backend .env).
# No separate frontend duration is needed.

# Frontend maintenance mode (UI lock only)
# Set to true to enable schedule checks.
VITE_MAINTENANCE_ENABLED=true
# ISO-8601 with timezone. Example: 2026-04-10T22:00:00+08:00
# Leave empty to start immediately when enabled.
VITE_MAINTENANCE_START=2026-03-31T00:00:00+08:00
# ISO-8601 with timezone. Example: 2026-04-11T06:00:00+08:00
# Leave empty for no automatic end.
VITE_MAINTENANCE_END=2026-12-31T23:59:59+08:00
# Optional message shown on /maintenance page.
VITE_MAINTENANCE_MESSAGE=System maintenance is in progress. Please try again later.
